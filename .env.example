# IterLens Bot Environment Variables
# Copy this file to .env and fill in the values

# Developer mode (true enables hot reload)
DEV=true

# Server port
PORT=8000

# CORS allowed origins (comma-separated, use * for all)
CORS_ORIGINS=*

# LLM Configuration
LLM_MODEL=mistral-large-latest
MISTRAL_API_KEY=your_mistral_api_key_here

# Database (Supabase)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Timezone for date calculations
TIMEZONE=America/Bogota

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
WEBHOOK_URL=https://your-domain.com/webhook/telegram

# WhatsApp (Evolution API)
EVOLUTION_API_URL=https://your-evolution-api-url
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=your_instance_name

# ElevenLabs (Speech-to-Text)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL=scribe_v2

# Threshold in seconds to ignore stale WhatsApp messages
OLD_MESSAGE_THRESHOLD_SECONDS=60
